{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadlimit.local/schemas/deadlimit-shade-character-profile-v1.json",
  "title": "Deadlimit Shade character profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "key",
    "displayName",
    "status",
    "retailReference",
    "directDiffuse",
    "directSpecular",
    "rimLighting",
    "previewLighting",
    "referenceTint",
    "outline",
    "painterApply"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "calibration",
        "validated"
      ]
    },
    "retailReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "buildId",
        "material",
        "materialSha256",
        "pixelShaderSha256"
      ],
      "properties": {
        "appId": { "type": "integer" },
        "buildId": { "type": "integer" },
        "material": { "type": "string", "minLength": 1 },
        "materialSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pixelShaderSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "directDiffuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "stepSharpness",
        "pbrBlend",
        "wrap",
        "normalization",
        "evidence"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "stepSharpness": { "type": "number", "minimum": 0.0, "maximum": 0.95 },
        "pbrBlend": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "wrap": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "normalization": { "type": "number", "minimum": 0.0, "maximum": 4.0 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "directSpecular": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "intensity", "roughnessScale", "threshold", "softness", "evidence"],
      "properties": {
        "enabled": { "type": "boolean" },
        "intensity": { "type": "number", "minimum": 0.0, "maximum": 4.0 },
        "roughnessScale": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "softness": { "type": "number", "minimum": 0.001, "maximum": 0.5 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "rimLighting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "color", "intensity", "power", "threshold", "softness", "evidence"],
      "properties": {
        "enabled": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0.0, "maximum": 4.0 },
        "power": { "type": "number", "minimum": 0.1, "maximum": 12.0 },
        "threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "softness": { "type": "number", "minimum": 0.001, "maximum": 0.5 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "previewLighting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyDirection", "keyColor", "keyIntensity", "environmentDiffuse", "environmentSpecular", "evidence"],
      "properties": {
        "keyDirection": { "$ref": "#/$defs/direction" },
        "keyColor": { "$ref": "#/$defs/color" },
        "keyIntensity": { "type": "number", "minimum": 0.0, "maximum": 4.0 },
        "environmentDiffuse": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "environmentSpecular": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "referenceTint": {
      "$ref": "#/$defs/color"
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "color",
        "colorEvidence",
        "widthMillimeters",
        "widthStatus"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "colorEvidence": { "$ref": "#/$defs/evidence" },
        "widthMillimeters": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 100.0 },
        "widthStatus": { "$ref": "#/$defs/evidence" }
      }
    },
    "painterApply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outlineAllMeshes",
        "heroTextureSets"
      ],
      "properties": {
        "outlineAllMeshes": { "const": true },
        "heroTextureSets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "retailPreview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourcePolicy", "materialBindings"],
          "properties": {
            "sourcePolicy": { "const": "project-0source-then-retail-vpk" },
            "vertexColorSource": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\\\]+\\.dmx$"
            },
            "materialBindings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["textureSet", "material"],
                "properties": {
                  "textureSet": { "type": "string", "minLength": 1 },
                  "material": { "type": "string", "pattern": "^[^\\\\]+\\.vmat_c$" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "enum": [
        "confirmed-pipeline-runtime",
        "confirmed-static-retail",
        "calibrated-approximation",
        "blocked-unresolved"
      ]
    },
    "direction": {
      "type": "array",
      "items": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
      "minItems": 3,
      "maxItems": 3
    },
    "color": {
      "type": "array",
      "items": { "type": "number", "minimum": 0.0 },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
