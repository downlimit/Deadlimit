<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>..\..\assets\Deadlimit_128_v4.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" Version="20.0.6980" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\Deadlimit_128_v4.ico" LogicalName="Deadlimit.AppIcon.ico" />
  </ItemGroup>

</Project>
