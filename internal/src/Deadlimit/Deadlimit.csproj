<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>DeadlimitManager</AssemblyName>
    <RootNamespace>Deadlimit</RootNamespace>
    <AssemblyTitle>Deadlimit Manager</AssemblyTitle>
    <Product>Deadlimit Manager</Product>
    <Description>Deadlock modding pipeline manager.</Description>
    <Version>0.1.0-beta.1</Version>
    <ApplicationIcon>..\..\assets\DeadlimitManager_128_v4.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KeyValues2" Version="0.8.0" />
    <PackageReference Include="ValveResourceFormat" Version="20.0.6980" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\DeadlimitManager_128_v4.ico" LogicalName="DeadlimitManager.AppIcon.ico" />
    <EmbeddedResource Include="..\..\..\.deadlimit\maxscript-vertcolor-trans\DeadlimitPipelineScripts.ms" LogicalName="Deadlimit.MaxScript.PipelineScripts.ms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\.deadlimit\maxscript-vertcolor-trans\**\*">
      <Link>.deadlimit\maxscript-vertcolor-trans\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\.deadlimit\csdk-fast-startup-cache\**\*">
      <Link>.deadlimit\csdk-fast-startup-cache\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
